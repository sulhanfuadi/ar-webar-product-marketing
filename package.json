{
  "name": "ar-webar-product-marketing",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "smoke:test": "node scripts/smoke-check.mjs",
    "marker:generate": "node scripts/generate-mvp-marker.mjs",
    "markers:generate": "npm run marker:generate",
    "test:compat": "playwright test",
    "test:desktop": "playwright test --project='Desktop Chrome' --project='Desktop Firefox' --project='Desktop Safari (WebKit)' --project='Desktop Edge'",
    "test:mobile": "playwright test --project='iPhone 14 – Safari (WebKit)' --project='iPhone 14 – Chrome iOS (WebKit)' --project='Pixel 7 – Chrome Android' --project='Pixel 7 – Samsung Internet' --project='Pixel 7 – Opera Android'",
    "test:report": "playwright show-report test-results/html-report",
    "test:report:gen": "node scripts/generate-compat-report.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.14.2",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@zenith-xperience/mindar-offline-compiler": "^0.0.2",
    "autoprefixer": "^10.4.21",
    "canvas": "^3.2.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vite": "^7.3.2"
  }
}
